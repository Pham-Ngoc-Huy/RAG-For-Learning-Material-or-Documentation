# ---------------------------------------------------------------------------
# LLM provider API keys
# Only one is required. If DEEPSEEK_API_KEY is set, DeepSeek is used;
# otherwise OPENAI_API_KEY is used; otherwise a local LLM fallback is used.
# ---------------------------------------------------------------------------
MODEL_CHOSEN=openrouter
OPENROUTER_API_KEY=skip-if-is-not-openrouter
OPENAI_API_KEY=skip-if-is-openrouter

# ---------------------------------------------------------------------------
# Qdrant vector database connection
# Leave blank to use the local Qdrant instance started via docker-compose.
# Set both to point at a hosted/cloud Qdrant instance instead.
# ---------------------------------------------------------------------------
QDRANT_ENDPOINT=http://localhost:6333
QDRANT_API_KEY=admin123
